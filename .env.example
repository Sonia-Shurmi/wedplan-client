# ---------------------------------------------------------------------------
# WedPlan client — copy this file to .env.local and fill in real values.
# Never commit .env.local.
# ---------------------------------------------------------------------------

# Public app URL (used for redirects and Better Auth issuer/audience)
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Express API (browser + server-side)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
API_URL=http://localhost:5000/api

# Better Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# MongoDB (server runtime only, never exposed to the browser)
MONGODB_URI=
DATABASE_NAME=wedplan

# Google OAuth (optional). Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_ENABLED=false
